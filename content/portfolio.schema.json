{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "projects": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "slug": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "summary": {
            "type": "string",
            "minLength": 1
          },
          "category": {
            "enum": [
              "engineering",
              "client"
            ]
          },
          "placement": {
            "enum": [
              "featured",
              "supporting",
              "archive",
              "hold"
            ]
          },
          "homepageOrder": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1
          },
          "role": {
            "type": "string",
            "minLength": 1
          },
          "stack": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "status": {
            "enum": [
              "live",
              "prototype",
              "in-progress",
              "archived"
            ]
          },
          "links": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "label": {
                  "type": "string",
                  "minLength": 1
                },
                "kind": {
                  "enum": [
                    "live",
                    "code",
                    "benchmark",
                    "write-up"
                  ]
                },
                "url": {
                  "type": "string",
                  "format": "uri"
                }
              },
              "required": [
                "label",
                "kind",
                "url"
              ]
            }
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "claim": {
                  "type": "string",
                  "minLength": 1
                },
                "label": {
                  "type": "string",
                  "minLength": 1
                },
                "url": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "format": "uri"
                },
                "basis": {
                  "enum": [
                    "repository-reported",
                    "source-reviewed",
                    "executed"
                  ]
                },
                "checkedAt": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "scope": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "claim",
                "label",
                "url",
                "basis",
                "checkedAt",
                "scope"
              ]
            }
          },
          "media": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "type": {
                  "enum": [
                    "image",
                    "video"
                  ]
                },
                "src": {
                  "type": "string",
                  "pattern": "^/"
                },
                "alt": {
                  "type": "string",
                  "minLength": 1
                },
                "width": {
                  "type": "integer",
                  "minimum": 1
                },
                "height": {
                  "type": "integer",
                  "minimum": 1
                },
                "poster": {
                  "type": "string",
                  "pattern": "^/"
                }
              },
              "required": [
                "type",
                "src",
                "alt",
                "width",
                "height"
              ]
            }
          },
          "caseStudy": {
            "anyOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "problem": {
                    "type": "string",
                    "minLength": 1
                  },
                  "constraints": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "decisions": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "choice": {
                          "type": "string",
                          "minLength": 1
                        },
                        "alternative": {
                          "type": "string",
                          "minLength": 1
                        },
                        "reason": {
                          "type": "string",
                          "minLength": 1
                        }
                      },
                      "required": [
                        "choice",
                        "alternative",
                        "reason"
                      ]
                    }
                  },
                  "verification": {
                    "type": "string",
                    "minLength": 1
                  },
                  "limitations": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                },
                "required": [
                  "problem",
                  "constraints",
                  "decisions",
                  "verification",
                  "limitations"
                ]
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "id",
          "slug",
          "title",
          "summary",
          "category",
          "placement",
          "homepageOrder",
          "role",
          "stack",
          "status",
          "links",
          "evidence",
          "media",
          "caseStudy"
        ]
      }
    },
    "experience": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "organization": {
            "type": "string",
            "minLength": 1
          },
          "role": {
            "type": "string",
            "minLength": 1
          },
          "period": {
            "type": "string",
            "minLength": 1
          },
          "summary": {
            "type": "string",
            "minLength": 1
          },
          "links": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "label": {
                  "type": "string",
                  "minLength": 1
                },
                "kind": {
                  "enum": [
                    "live",
                    "code",
                    "benchmark",
                    "write-up"
                  ]
                },
                "url": {
                  "type": "string",
                  "format": "uri"
                }
              },
              "required": [
                "label",
                "kind",
                "url"
              ]
            }
          }
        },
        "required": [
          "organization",
          "role",
          "period",
          "summary"
        ]
      }
    }
  },
  "required": [
    "schemaVersion",
    "projects",
    "experience"
  ]
}
