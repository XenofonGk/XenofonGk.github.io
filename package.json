{
  "name": "xgbuilds",
  "private": true,
  "version": "2.0.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "npx serve out",
    "typecheck": "tsc --noEmit",
    "build:wasm": "./wasm/build.sh",
    "preview": "node scripts/serve.mjs",
    "test:browser": "playwright test",
    "check:content": "node scripts/check-content.mjs",
    "social": "node scripts/generate-social.mjs",
    "format:check": "prettier --check app components lib tests scripts content playwright.config.ts next.config.ts",
    "format": "prettier --write app components lib tests scripts content playwright.config.ts next.config.ts",
    "test:wasm": "bash wasm/tests/run.sh"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "next": "^16.4.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3"
  }
}
